    "store_duplicate_entries_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Text Memify will store entries that have the same original and result text. Original text with different result will still always be stored."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được kích hoạt, Text Memify sẽ lưu trữ các mục có văn bản gốc và văn bản kết quả giống nhau. Văn bản gốc với kết quả khác nhau vẫn sẽ luôn được lưu trữ."
          }
        }
